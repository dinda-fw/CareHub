# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Default City Settings
NEXT_PUBLIC_DEFAULT_CITY=Surabaya
NEXT_PUBLIC_DEFAULT_LAT=-7.2575
NEXT_PUBLIC_DEFAULT_LNG=112.7521

# Payment Gateway Configuration (Midtrans Snap & Escrow)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY

# Optional: iPaymu Gateway
IPAYMU_API_KEY=
IPAYMU_VA=
IPAYMU_IS_PRODUCTION=false
